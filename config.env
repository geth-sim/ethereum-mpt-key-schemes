# Pinned source revisions used by the reproducibility workflow.
: "${GETH_REPOSITORY:=https://github.com/geth-sim/go-ethereum.git}"
: "${GETH_COMMIT:=7bed84818bc0f34910f51f79a065506841abd0e9}"
: "${SYNC_GETH_REPOSITORY:=https://github.com/ethereum/go-ethereum.git}"
# Official geth release v1.17.3. The commit is the authoritative checkout pin.
: "${SYNC_GETH_VERSION:=v1.17.3}"
: "${SYNC_GETH_COMMIT:=117e067f0f0bae1a17082321f224dedb6765b10f}"
: "${GOLEVELDB_REPOSITORY:=https://github.com/geth-sim/goleveldb.git}"
: "${DATA_ANALYSIS_REPOSITORY:=https://github.com/geth-sim/data-analysis.git}"
: "${DATA_ANALYSIS_COMMIT:=42f0addba0fc38adb436cfb2cfbc8c57681de79f}"
# Fast performance build: no detailed read instrumentation in LevelDB hot paths.
: "${GOLEVELDB_FAST_COMMIT:=24ca656225dcb95c7055d2d64630e24b5193b270}"
# Detailed build: negative lookups, data-block cache hits, and bloom statistics.
: "${GOLEVELDB_STATS_COMMIT:=c3bb47c7435a9831d7afa3c56f20170a2c33dd9a}"
# Go 1.21+ can select the exact build toolchains below. If the host Go is
# missing or older, the artifact installs this checksum-pinned bootstrap under
# runtime/toolchains without modifying the system installation.
: "${GO_BOOTSTRAP_VERSION:=1.24.13}"
: "${GO_BOOTSTRAP_SHA256:=1fc94b57134d51669c72173ad5d49fd62afb0f1db9bf3f798fd98ee423f8d730}"
: "${GO_TOOLCHAIN:=go1.21.13}"
: "${SYNC_GO_TOOLCHAIN:=go1.24.13}"

# Quick check and reduced E1--E7 configuration checks. Transactions occur in this range
# (1,871 transactions in blocks 0--50,000; first at block 46,147).
: "${TARGET_50K_BLOCK:=50000}"
: "${TARGET_50K_HASH:=0x0e30a7c0c1cee426011e274abc746c1ad3c48757433eb0139755658482498aa9}"
: "${TARGET_BLOCK:=$TARGET_50K_BLOCK}"
: "${TARGET_HASH:=$TARGET_50K_HASH}"
: "${GENESIS_HASH:=0xd4e56740f876aef8c010b86a40d5f56745a118d0906a34e69aec8c0db1cb8fa3}"

# Optional Table 4 backend/compression storage comparison.
: "${TARGET_250K_BLOCK:=250000}"
: "${TARGET_250K_HASH:=0x8078cc5a09d917be6300aef3043695b9be6da9bb4178ec9895c99fefd96660c7}"

# Optional shorter endpoint.
: "${TARGET_500K_BLOCK:=500000}"
: "${TARGET_500K_HASH:=0xac8e95f7483f7131261bcc0a70873f8236c27444c940defc677f74f281220193}"

# Default H/PVstar/VPstar stats-smoke target.
: "${TARGET_1M_BLOCK:=1000000}"
: "${TARGET_1M_HASH:=0x8e38b4dbf6b11fcc3b9dee84fb7986e29ca0a02cecd8977c161ff7333329681e}"

# Acquire the requested target by default. Override both INPUT_TARGET values
# to prepare a larger prefix for reuse by later runs.
: "${INPUT_TARGET_BLOCK:=$TARGET_BLOCK}"
: "${INPUT_TARGET_HASH:=$TARGET_HASH}"
: "${INPUT_ACQUISITION_METHOD:=era}"
: "${INPUT_ACQUISITION_FALLBACK:=target-sync}"
: "${ERA_FORMAT:=era1}"
: "${ERA_ENDPOINTS:=https://mainnet.era1.nimbus.team}"
: "${ERA_DOWNLOAD_ATTEMPTS:=2}"

# Paper workload endpoint. Use these as TARGET_BLOCK/TARGET_HASH overrides for
# full-scale acquisition, MariaDB materialization, and E1--E7 runners.
: "${TARGET_10M_BLOCK:=10000000}"
: "${TARGET_10M_HASH:=0xaa20f7bde5be60603f11a45fc4923aab7552be775403fc00c2e6b805e6297dbe}"

: "${GETH_RPC_HOST:=127.0.0.1}"
: "${GETH_RPC_PORT:=28545}"
: "${GETH_P2P_PORT:=30333}"
: "${GETH_CACHE_MB:=1024}"
: "${SYNC_TARGET_RPC_TIMEOUT:=3600}"
: "${SIMULATOR_HOST:=127.0.0.1}"
: "${SIMULATOR_PORT:=28889}"
# `fast` measures performance without LevelDB hot-path instrumentation;
# `stats` writes detailed read statistics from the measureReadStats LevelDB.
: "${SIMULATOR_VARIANT:=fast}"
: "${SIMULATOR_SCHEME:=H}"
: "${SIMULATOR_STATE_MODE:=auto}"
: "${SIMULATOR_PATHDB_HISTORY:=true}"
: "${SIMULATOR_DB_BACKEND:=leveldb}"
: "${SIMULATOR_COMPRESSION:=snappy}"
: "${SIMULATOR_MYHASH:=false}"
: "${SIMULATOR_MYHASH_CACHE_MB:=0}"
: "${SIMULATOR_MYHASH_CACHE_MODE:=unified}"
: "${SIMULATOR_DISK_SIZE_MULTIPLIER:=1.0}"
: "${SIMULATOR_VERSION_WRAP:=none}"
: "${SIMULATOR_ACCURATE_READ_COUNTERS:=false}"
: "${SIMULATOR_CHILD_STATS:=false}"
: "${SIMULATOR_DISK_SIZE_INTERVAL:=10000}"
# E1--E7 share this cadence for simulator JSON and cumulative statistics.
# A final checkpoint is also saved when the target is not an exact multiple.
: "${SIMULATOR_RESULT_SAVE_INTERVAL:=500000}"
: "${SIMULATOR_LEVELDB_STATS_INTERVAL:=$SIMULATOR_RESULT_SAVE_INTERVAL}"
: "${PROGRESS_INTERVAL:=1000}"
# Prefer the artifact's analysis virtual environment, falling back to python3.
# Set a Python executable explicitly to override automatic selection.
: "${ANALYSIS_PYTHON:=auto}"

# Optional MariaDB input cache for repeated/full-scale experiments. The server
# binds only to localhost and stores all files under runtime/mariadb.
: "${MARIADB_HOST:=127.0.0.1}"
: "${MARIADB_PORT:=23306}"
: "${MARIADB_USER:=artifact}"
: "${MARIADB_PASSWORD:=artifact}"
: "${MARIADB_DATABASE:=ethereum_artifact}"
